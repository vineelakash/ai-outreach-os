# ==========================================
# AI OUTREACH OS - ENVIRONMENT CONFIGURATION
# ==========================================

# Application URL
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth / Session Secret (Generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="dev-secret-change-in-production-min-32-chars-long"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://outreach_user:outreach_secret_pass@localhost:5432/ai_outreach_db?schema=public"

# Redis Connection (BullMQ background queues)
REDIS_URL="redis://localhost:6379"

# Encryption Key for sensitive credentials at rest (32 bytes / 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Default AI Providers (Can also be configured securely per-organization in UI)
AI_PROVIDER="mock" # options: openai, gemini, anthropic, mock
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# OAuth Integrations (Optional for Google Workspace and Microsoft 365 OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Analytics (First-party + Google Analytics 4)
# Privacy safe: No lead emails or message content are ever transmitted
NEXT_PUBLIC_GA_ID=""

# Tracking & Compliance
ENABLE_OPEN_TRACKING="true"
ENABLE_CLICK_TRACKING="true"
GLOBAL_UNSUBSCRIBE_FOOTER="true"
TRACKING_DOMAIN="http://localhost:3000"

# Application Mode
NODE_ENV="development"
